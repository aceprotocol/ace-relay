{
  "name": "@ace-protocol/relay",
  "version": "0.4.0",
  "description": "ACE Protocol relay: store-and-forward for opaque prekey packets (ace-spec 07)",
  "type": "module",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\""
  },
  "dependencies": {
    "@ace-protocol/sdk": "file:../sdk-ts",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "Apache-2.0"
}
